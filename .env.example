# Server
PORT=5000

# Database (MySQL)
DATABASE_NAME=vn_cultural_gis
DATABASE_USER=root
DATABASE_PASSWORD=1234
# Hosted DB domain/IP (for local dev you can use: localhost)
DATABASE_HOST=YOUR_DB_HOST
DATABASE_PORT=3306

# Auth
# Use a strong random string in production
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# Elasticsearch (optional)
# Public Elasticsearch URL (ngrok). Include scheme (https://)
ELASTICSEARCH_URL=https://unlumped-inexpugnable-brandee.ngrok-free.dev
ELASTICSEARCH_PLACE_LOCATIONS_INDEX=place_locations

# Logstash JDBC
# If you run MySQL locally on Windows, Logstash container can connect via host.docker.internal
# If you use a hosted MySQL, replace host.docker.internal with your DB host/domain that is reachable from Docker.
JDBC_CONNECTION_STRING=jdbc:mysql://YOUR_DB_HOST:3306/vn_cultural_gis?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh
JDBC_USER=root
JDBC_PASSWORD=1234

# VNPay Config (Sandbox defaults will be used if left empty)
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=

