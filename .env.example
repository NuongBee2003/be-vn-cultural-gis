# Server
PORT=5000
NODE_ENV=development

# Database (MySQL)
DATABASE_NAME=vn_cultural_gis
DATABASE_USER=root
DATABASE_PASSWORD=1234
DATABASE_HOST=localhost
DATABASE_PORT=3306

# Auth
# Use a strong random string in production
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_UPDATE_MAX=20
RATE_LIMIT_USER_LIST_MAX=60

# Elasticsearch (optional)
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_PLACE_LOCATIONS_INDEX=place_locations

# Logstash JDBC
# If you run MySQL locally on Windows, Logstash container can connect via host.docker.internal
JDBC_CONNECTION_STRING=jdbc:mysql://host.docker.internal:3306/vn_cultural_gis?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh
JDBC_USER=root
JDBC_PASSWORD=1234
