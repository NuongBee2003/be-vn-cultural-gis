# Server
PORT=5000
NODE_ENV=development

# Database (MySQL)
DATABASE_NAME=vn_cultural_gis
DATABASE_USER=root
DATABASE_PASSWORD=1234
DATABASE_HOST=localhost
DATABASE_PORT=3306

# Auth
# Use a strong random string in production
JWT_SECRET=change-me

# Elasticsearch (optional)
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_PLACES_INDEX=places

# Logstash JDBC
# If you run MySQL locally on Windows, Logstash container can connect via host.docker.internal
JDBC_CONNECTION_STRING=jdbc:mysql://host.docker.internal:3306/vn_cultural_gis?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
JDBC_USER=root
JDBC_PASSWORD=1234
