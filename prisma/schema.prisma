generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS (CÁC KIỂU LIỆT KÊ)
// ==========================================
enum UserRole {
  admin
  user
}

enum ModerationStatus {
  pending
  accepted
  rejected
}

enum TourStatus {
  active
  closed
  draft
}

enum StopType {
  start
  checkpoint
  rest
  end
}

enum PaymentStatus {
  pending
  paid
  cancelled
}

// ==========================================
// NHÓM 1: QUẢN LÝ PHÂN KHU & DANH MỤC
// ==========================================
model Region {
  id        Int        @id @default(autoincrement())
  name      String     @db.VarChar(50)
  
  provinces Province[]

  @@map("regions")
}

model Province {
  id       Int     @id @default(autoincrement())
  name     String  @db.VarChar(100)
  regionId Int?    @map("region_id")
  
  region   Region? @relation(fields: [regionId], references: [id], onDelete: Restrict)
  locations Location[]

  @@index([regionId])
  @@map("provinces")
}

model Category {
  id         Int     @id @default(autoincrement())
  name       String  @db.VarChar(100)
  iconMarker String? @map("icon_marker") @db.VarChar(255)

  places     Place[]

  @@map("categories")
}

// ==========================================
// NHÓM 2: NGƯỜI DÙNG, ĐỊA DANH & VỊ TRÍ
// ==========================================
model User {
  id           Int      @id @default(autoincrement())
  username     String   @db.VarChar(100)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         UserRole @default(user)
  avatar       String?  @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at")

  placesCreated Place[]   @relation("UserCreatedPlaces")
  reviews       Review[]
  posts         Post[]
  checkIns      CheckIn[]
  bookings      Booking[]
  wishlists     Wishlist[] 

  @@map("users")
}

// Bảng Địa danh (Phần "Hồn" - Giá trị văn hóa, lịch sử)
model Place {
  id          Int              @id @default(autoincrement())
  name        String           @db.VarChar(255)
  description String?          @db.Text
  categoryId  Int?             @map("category_id")
  metadata    Json?            // Chứa giờ mở cửa, giá vé, website...
  status      ModerationStatus @default(pending)
  createdById Int?             @map("created_by")
  createdAt   DateTime         @default(now()) @map("created_at")

  category    Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy   User?     @relation("UserCreatedPlaces", fields: [createdById], references: [id], onDelete: SetNull)

  locations   Location[]
  periods     PlacePeriod[]
  assets      Asset[]   // Liên kết 1-N với bảng Asset

  @@index([categoryId])
  @@index([createdById])
  @@map("places")
}

// Bảng Vị trí (Phần "Xác" - Tọa độ, địa chỉ cụ thể của Địa danh)
model Location {
  id         Int              @id @default(autoincrement())
  placeId    Int              @map("place_id")
  address    String?          @db.VarChar(255)
  lat        Decimal?         @db.Decimal(10, 8)
  lng        Decimal?         @db.Decimal(11, 8)
  provinceId Int?             @map("province_id")
  status     ModerationStatus @default(pending)

  place      Place     @relation(fields: [placeId], references: [id], onDelete: Cascade)
  province   Province? @relation(fields: [provinceId], references: [id], onDelete: Restrict)

  reviews         Review[]
  posts           Post[]
  checkIns        CheckIn[]
  tourItineraries TourItinerary[]
  wishlistDetails WishlistDetail[] 
  assets          Asset[]   // Liên kết 1-N với bảng Asset

  @@index([placeId])
  @@index([lat, lng], map: "idx_locations_coords")
  @@index([provinceId])
  @@map("locations")
}

// ==========================================
// NHÓM 3: LỊCH SỬ & VĂN HÓA
// ==========================================
model HistoricalPeriod {
  id            Int     @id @default(autoincrement())
  name          String  @db.VarChar(255)
  description   String? @db.Text
  notableFigure String? @map("notable_figure") @db.VarChar(255)
  figureDesc    String? @map("figure_desc") @db.Text
  imageUrl      String? @map("image_url") @db.VarChar(255) // Thời kỳ chỉ cần 1 ảnh đại diện

  events HistoricalEvent[]
  places PlacePeriod[]

  @@map("historical_periods")
}

model HistoricalEvent {
  id          Int     @id @default(autoincrement())
  periodId    Int?    @map("period_id")
  name        String  @db.VarChar(255)
  description String? @db.Text

  period HistoricalPeriod? @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@index([periodId])
  @@map("historical_events")
}

model PlacePeriod {
  placeId  Int @map("place_id")
  periodId Int @map("period_id")

  place  Place            @relation(fields: [placeId], references: [id], onDelete: Cascade)
  period HistoricalPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@id([placeId, periodId])
  @@map("place_periods")
}

// ==========================================
// NHÓM 4: TƯƠNG TÁC CỘNG ĐỒNG & WISHLIST
// ==========================================
model Review {
  id         Int      @id @default(autoincrement())
  userId     Int?     @map("user_id")
  locationId Int?     @map("location_id")
  rating     Int
  comment    String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)
  assets   Asset[]   // Liên kết 1-N với bảng Asset

  @@index([userId])
  @@index([locationId])
  @@map("reviews")
}

model Post {
  id         Int              @id @default(autoincrement())
  userId     Int?             @map("user_id")
  locationId Int?             @map("location_id")
  title      String           @db.VarChar(255)
  content    String           @db.Text
  status     ModerationStatus @default(pending)
  createdAt  DateTime         @default(now()) @map("created_at")

  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  assets   Asset[]   // Liên kết 1-N với bảng Asset

  @@index([userId])
  @@index([locationId])
  @@map("posts")
}

model CheckIn {
  id         Int      @id @default(autoincrement())
  userId     Int?     @map("user_id")
  locationId Int?     @map("location_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)
  assets   Asset[]   // Liên kết 1-N với bảng Asset

  @@index([userId])
  @@index([locationId])
  @@map("check_ins")
}

// Bảng Master: Danh sách yêu thích của người dùng
model Wishlist {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  title       String   @db.VarChar(255)
  description String?  @db.Text
  isPublic    Boolean  @default(false) @map("is_public")
  createdAt   DateTime @default(now()) @map("created_at")

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  details WishlistDetail[]

  @@index([userId])
  @@map("wishlists")
}

// Bảng Detail: Các địa điểm cụ thể bên trong 1 danh sách
model WishlistDetail {
  id         Int      @id @default(autoincrement())
  wishlistId Int      @map("wishlist_id")
  locationId Int      @map("location_id")
  addedAt    DateTime @default(now()) @map("added_at")

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, locationId]) 
  @@index([locationId])
  @@map("wishlist_details")
}

// ==========================================
// NHÓM 5: QUẢN LÝ TÀI SẢN TRUYỀN THÔNG (ASSETS)
// ==========================================
model Asset {
  id         Int      @id @default(autoincrement())
  url        String   @db.Text // Sử dụng Text để hỗ trợ các URL dài từ Cloudinary/S3
  isPrimary  Boolean  @default(false) @map("is_primary") // Đánh dấu ảnh bìa/ảnh chính
  createdAt  DateTime @default(now()) @map("created_at")

  // Khóa ngoại (Nullable) trỏ đến các thực thể sở hữu ảnh
  placeId    Int?     @map("place_id")
  locationId Int?     @map("location_id")
  postId     Int?     @map("post_id")
  reviewId   Int?     @map("review_id")
  checkInId  Int?     @map("check_in_id")

  // Quan hệ trỏ về các bảng gốc (Hỗ trợ Xóa dây chuyền - Cascade)
  place      Place?    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  location   Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)
  post       Post?     @relation(fields: [postId], references: [id], onDelete: Cascade)
  review     Review?   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  checkIn    CheckIn?  @relation(fields: [checkInId], references: [id], onDelete: Cascade)

  @@index([placeId])
  @@index([locationId])
  @@index([postId])
  @@index([reviewId])
  @@index([checkInId])
  @@map("assets")
}

// ==========================================
// NHÓM 6: TOUR DU LỊCH & BOOKING
// ==========================================
model Tour {
  id              Int        @id @default(autoincrement())
  title           String     @db.VarChar(255)
  description     String?    @db.Text
  price           Decimal    @db.Decimal(10, 2)
  durationDays    Int        @default(1) @map("duration_days")
  maxParticipants Int        @default(20) @map("max_participants")
  status          TourStatus @default(active)
  createdAt       DateTime   @default(now()) @map("created_at")

  itineraries TourItinerary[]
  bookings    Booking[]

  @@map("tours")
}

model TourItinerary {
  id          Int       @id @default(autoincrement())
  tourId      Int       @map("tour_id")
  locationId  Int       @map("location_id")
  stopOrder   Int       @map("stop_order")
  stopType    StopType  @default(checkpoint) @map("stop_type")
  arrivalTime DateTime? @db.Time @map("arrival_time")
  noteAtStop  String?   @db.Text @map("note_at_stop")

  tour     Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([tourId])
  @@index([locationId])
  @@map("tour_itineraries")
}

model Booking {
  id            Int           @id @default(autoincrement())
  userId        Int           @map("user_id")
  tourId        Int           @map("tour_id")
  bookingDate   DateTime      @db.Date @map("booking_date")
  numAdults     Int           @default(1) @map("num_adults")
  numChildren   Int           @default(0) @map("num_children")
  totalPrice    Decimal       @db.Decimal(12, 2) @map("total_price")
  paymentStatus PaymentStatus @default(pending) @map("payment_status")
  note          String?       @db.Text
  createdAt     DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  tour Tour @relation(fields: [tourId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([tourId])
  @@map("bookings")
}